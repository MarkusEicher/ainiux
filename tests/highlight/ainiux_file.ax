"""Ainiux syntax-highlighting fixture.

This module combines the three suite styles, class/struct/enum declarations,
f/r/b strings, match arms, pipes, ranges, and lambdas used by later native
highlighting and indent work.
"""

# Named functions: braces, an inline suite, and an indented suite.
fn multiply(value: int, factor: int = 2) -> int { """Multiply the operands.""";  value * factor }
fn square(value: int) -> int: """Return the square of the numeric argument.""";  value * value
fn greet(name: str, *, prefix: str = "Hello") -> str:
    """Return a greeting using the selected name and prefix."""
    f"{prefix}, {name}!"

fn apply_twice(transform: fn, value: int) -> int {
    """Call the supplied function twice in succession."""
    transform(transform(value))
}

enum Level {
    easy = 1
    medium = 2
    hard = 3
}

struct Point(x: int, y: int)

class Greeter {
    """A named greeter with overridable methods and a private helper."""
    name: str
    enabled: bool = true

    fn init(name: str) { """Initialize name from constructor inputs.""";  this.name = name }
    fn speak() -> str = "hello"
    fn _label() -> str { """Format the private display label.""";  this.name or "world" }
    static fn from_name(name: str) -> Greeter { """Construct a greeter from a name.""";  Greeter(name) }
    fn line(punctuation: str = "!") -> str {
        message = """Hello from a string
which spans multiple lines
and remains one Ainiux value."""
        raw = r"\d+"
        blob = b"bytes"
        f"{message}\nWelcome, {this._label()}{punctuation} {raw} {blob}"
    }
}

fn classify(code: int) -> str {
    """Return a status band using range match arms."""
    match code {
        100..200 => "informational",
        200..=299 => "success",
        _ => "other",
    }
}

names: [str] = ["Ada", "Grace", "Linus"]
scores: {str: int} = {"Ada": 100, "Grace": 98, "Linus": 95}
origin = Point(0, 0)
price: fp = 12.5

greeter = Greeter.from_name(names[0])
if greeter.enabled {
    print(greeter.line())
}

print("pipe:", 5 |> multiply(3) |> square)
print("lambda:", apply_twice(x => x + 3, 2))
print("range:", *(1..=3), "level:", Level.medium)
print(f"The price is {price:.2f} dollars")
print("band:", classify(204))
